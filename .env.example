# Application
APP_ENV=demo
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_PATH=data/evidencetrail.db
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Zetaris live adapter (only required for APP_ENV=live)
ZETARIS_BASE_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
ZETARIS_TIMEOUT_SECONDS=20
ZETARIS_PAGE_LIMIT=100
# registered: query existing tables; inline_synthetic: send labeled demo rows as SQL VALUES.
ZETARIS_DATASET_MODE=registered

# NVIDIA Nemotron OpenAI-compatible adapter (only required for live LLM analysis)
# For OpenRouter: MODEL_BASE_URL=https://openrouter.ai/api/v1
# NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning:free
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
NEMOTRON_MODEL=
MODEL_TIMEOUT_SECONDS=45

# Pinned local Meterless reference engine. Verified via conformance + restart tests.
# Enable explicitly after reviewing docs/HMEM_VERIFICATION.md. Node 24.22+ required.
# No HTTP endpoint or credentials needed. Defaults remain disabled.
METERLESS_HMEM_ENABLED=false
METERLESS_HMEM_NODE_BINARY=node
# Legacy reserved settings below are unused by the local reference engine.
METERLESS_HMEM_BASE_URL=
METERLESS_HMEM_API_KEY=
